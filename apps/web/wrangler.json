{
	"name": "my-personal-website",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./dist/_worker.js/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "API",
			"service": "my-personal-website-api"
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}

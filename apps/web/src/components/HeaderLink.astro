---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & { href: string };
const { href, ...props } = Astro.props;
const active = href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(href);
---

<a href={href} aria-current={active ? (Astro.url.pathname === href ? 'page' : 'location') : undefined}
	class:list={['nav-link', { 'nav-current': active }]} {...props}><slot /></a>

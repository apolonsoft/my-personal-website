{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "my-personal-website-api",
	"main": "src/main.py",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": [
		"python_workers"
	],
	"observability": {
		"enabled": true
	},
	"vars": {
		"ENVIRONMENT": "production",
		"R2_PUBLIC_BASE_URL": "",
		"EMAIL_FROM": "noreply@apolonsoft.dev",
		"EMAIL_FROM_NAME": "Apolonsoft",
		"FRONTEND_URL": "https://www.apolonsoft.dev"
	},
	"send_email": [
		{
			"name": "EMAIL"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "personal-website-db",
			// Replace with the UUID returned by: npx wrangler d1 create personal-website-db
			"database_id": "2e927b58-6d59-47a2-9844-88a4acb23889",
			"migrations_dir": "migrations_d1"
		}
	],
	"r2_buckets": [
		{
			"binding": "IMAGES_BUCKET",
			"bucket_name": "personal-website-images"
		}
	]
}
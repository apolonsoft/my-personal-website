---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	article?: boolean;
}
const { title = SITE_TITLE, description = SITE_DESCRIPTION, image, article } = Astro.props;
---

<!doctype html>
<html lang="en" id="top">
	<head><BaseHead {title} {description} {image} {article} /></head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<Header />
		<main id="main" class="page-shell"><slot /></main>
		<Footer />
	</body>
</html>

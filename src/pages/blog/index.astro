---
import Page from '../../layouts/Page.astro';
import PostMeta from '../../components/PostMeta.astro';
import { profile } from '../../consts';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
const description = 'Notes on building websites, designing interfaces, and the decisions in between.';
---

<Page title={`Blog — ${profile.name}`} {description}>
	<header class="py-16 sm:pt-24 sm:pb-20">
		<h1 class="display">Blog.</h1>
		<p class="lead mt-6 max-w-xl">{description}</p>
	</header>
	<ul aria-label="Blog posts" class="border-t border-studio-ink/40">
		{posts.map(({ id, data }) => (
			<li class="border-b border-studio-ink/30">
				<a class="group grid grid-cols-[minmax(0,1fr)_80px] items-center gap-4 py-7 sm:grid-cols-[minmax(0,1fr)_190px] sm:gap-10 sm:py-8" href={`/blog/${id}/`}>
					<div>
						<PostMeta category={data.category} date={data.pubDate} />
						<h2 class="mt-2 text-[22px] leading-tight font-semibold tracking-[-0.035em] group-hover:underline sm:text-3xl">{data.title}</h2>
						<p class="mt-2 max-w-2xl text-base text-studio-ink/75">{data.description}</p>
					</div>
					<img class="aspect-square w-full rounded-xl object-cover sm:aspect-[1.6]" width="320" height="200" src={data.heroImage} alt="" />
				</a>
			</li>
		))}
	</ul>
</Page>
